{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/authorial-edge-judge-model-response.schema.json",
  "title": "Raw Authorial Edge Judge response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "edge_id",
    "selected_candidate_ids",
    "rhetorical_function_preserved",
    "downstream_dependency_preserved",
    "contradiction_found",
    "missing_facets",
    "reason",
    "confidence"
  ],
  "properties": {
    "edge_id": {"type": "string", "minLength": 1},
    "selected_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "rhetorical_function_preserved": {"type": "boolean"},
    "downstream_dependency_preserved": {"type": "boolean"},
    "contradiction_found": {"type": "boolean"},
    "missing_facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "direction",
          "hierarchy",
          "rhetorical_function",
          "downstream_dependency",
          "scope",
          "case_function",
          "closure_return"
        ]
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  }
}
