{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/judge-result.schema.json",
  "title": "Atomic judge result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "book_id",
    "submission_id",
    "criterion_id",
    "verdict",
    "evidence",
    "contradiction_found",
    "reason",
    "confidence",
    "judge_model",
    "prompt_version"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "submission_id": {
      "type": "string",
      "minLength": 1
    },
    "criterion_id": {
      "type": "string",
      "minLength": 1
    },
    "verdict": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "quote"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "found",
            "none"
          ]
        },
        "quote": {
          "type": "string"
        },
        "start_char": {
          "type": "integer",
          "minimum": 0
        },
        "end_char": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "contradiction_found": {
      "type": "boolean"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "judge_model": {
      "type": "string",
      "minLength": 1
    },
    "prompt_version": {
      "type": "string",
      "minLength": 1
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "const": "none"
              }
            },
            "required": [
              "status"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "verdict": {
            "const": 0
          },
          "evidence": {
            "properties": {
              "quote": {
                "const": ""
              }
            },
            "required": [
              "quote"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verdict": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "evidence": {
            "properties": {
              "status": {
                "const": "found"
              },
              "quote": {
                "minLength": 1
              }
            }
          },
          "contradiction_found": {
            "const": false
          }
        }
      }
    }
  ]
}
