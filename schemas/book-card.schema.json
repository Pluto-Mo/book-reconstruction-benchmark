{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/book-card.schema.json",
  "title": "Book-specific evaluation card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "book_id",
    "title",
    "domain",
    "source",
    "compression",
    "relations",
    "genericity_traps",
    "organization_behaviors",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.1"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "human_reviewed",
        "frozen"
      ]
    },
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "locator_scheme"
      ],
      "properties": {
        "document_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "locator_scheme": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_chars",
        "max_chars"
      ],
      "properties": {
        "min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "summary",
          "source_anchors",
          "atoms",
          "non_examples",
          "contradictions",
          "weight",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "source_anchors": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "locator",
                "evidence_summary"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                },
                "chapter": {
                  "type": "string"
                },
                "section": {
                  "type": "string"
                },
                "evidence_summary": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "atoms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "requirement",
                "source_anchor_ids",
                "acceptable_paraphrases",
                "pass_if",
                "fail_if",
                "common_false_positives",
                "contradiction_patterns",
                "weight",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "source_anchor_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "acceptable_paraphrases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pass_if": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fail_if": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "common_false_positives": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "contradiction_patterns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "critical": {
                  "type": "boolean"
                }
              }
            }
          },
          "non_examples": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "contradictions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "genericity_traps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "why_insufficient",
          "related_atom_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "why_insufficient": {
            "type": "string",
            "minLength": 1
          },
          "related_atom_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "organization_behaviors": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "behavior",
          "positive_anchor",
          "negative_anchor",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "behavior": {
            "type": "string",
            "minLength": 1
          },
          "positive_anchor": {
            "type": "string",
            "minLength": 1
          },
          "negative_anchor": {
            "type": "string",
            "minLength": 1
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "reviewed_by",
        "review_notes"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_notes": {
          "type": "string"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "frozen_at"
            ]
          }
        }
      }
    }
  ]
}
