{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/book-card.schema.json",
  "title": "Book-specific cognitive-structure rubric card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "book_id",
    "title",
    "domain",
    "source",
    "compression",
    "source_anchors",
    "cognitive_structures",
    "genericity_traps",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "human_reviewed",
        "frozen"
      ]
    },
    "book_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "domain": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_sha256",
        "locator_scheme"
      ],
      "properties": {
        "document_sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "locator_scheme": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "compression": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_chars",
        "max_chars"
      ],
      "properties": {
        "min_chars": {
          "type": "integer",
          "minimum": 1
        },
        "max_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "source_anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "locator",
          "evidence_summary",
          "argument_function"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "locator": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "evidence_summary": {
            "type": "string",
            "minLength": 1
          },
          "argument_function": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "cognitive_structures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "central_question",
          "summary",
          "nodes",
          "relations",
          "paths",
          "weight",
          "rationale"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "central_question": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "statement",
                "role",
                "stance_owner",
                "epistemic_status",
                "source_anchor_ids",
                "essential"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "question",
                    "claim",
                    "premise",
                    "assumption",
                    "mechanism",
                    "condition",
                    "boundary",
                    "evidence",
                    "case",
                    "counterexample",
                    "objection",
                    "rebuttal",
                    "conclusion",
                    "implication",
                    "action"
                  ]
                },
                "stance_owner": {
                  "type": "string",
                  "enum": [
                    "author",
                    "opponent",
                    "cited_source",
                    "hypothetical",
                    "neutral"
                  ]
                },
                "epistemic_status": {
                  "type": "string",
                  "enum": [
                    "asserted",
                    "assumed",
                    "conceded",
                    "rejected",
                    "qualified",
                    "unresolved",
                    "observed"
                  ]
                },
                "source_anchor_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "essential": {
                  "type": "boolean"
                },
                "case_profile": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "function",
                    "preservation"
                  ],
                  "properties": {
                    "function": {
                      "type": "string",
                      "enum": [
                        "constitutive",
                        "illustrative"
                      ]
                    },
                    "preservation": {
                      "type": "string",
                      "enum": [
                        "required",
                        "replaceable",
                        "optional"
                      ]
                    },
                    "replacement_rule": {
                      "type": "string"
                    }
                  }
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "role": {
                        "enum": [
                          "case",
                          "counterexample"
                        ]
                      }
                    },
                    "required": [
                      "role"
                    ]
                  },
                  "then": {
                    "required": [
                      "case_profile"
                    ]
                  }
                }
              ]
            }
          },
          "relations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "source_node_ids",
                "target_node_ids",
                "relation_type",
                "requirement",
                "required_facets",
                "source_anchor_ids",
                "acceptable_paraphrases",
                "pass_if",
                "fail_if",
                "common_false_positives",
                "contradiction_patterns",
                "weight",
                "critical"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_node_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "target_node_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "relation_type": {
                  "type": "string",
                  "enum": [
                    "causes",
                    "supports",
                    "jointly_supports",
                    "explains",
                    "qualifies",
                    "limits",
                    "refutes",
                    "contradicts",
                    "distinguishes",
                    "exemplifies",
                    "instantiates",
                    "enables",
                    "implies",
                    "precedes"
                  ]
                },
                "requirement": {
                  "type": "string",
                  "minLength": 1
                },
                "required_facets": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "enum": [
                      "direction",
                      "mechanism",
                      "condition",
                      "boundary",
                      "stance_owner",
                      "epistemic_status",
                      "argument_function",
                      "case_identity"
                    ]
                  }
                },
                "source_anchor_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "acceptable_paraphrases": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "pass_if": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "fail_if": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "common_false_positives": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "contradiction_patterns": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "critical": {
                  "type": "boolean"
                }
              }
            }
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label",
                "relation_ids",
                "path_type",
                "weight",
                "rationale"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "relation_ids": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "path_type": {
                  "type": "string",
                  "enum": [
                    "mandatory",
                    "alternative"
                  ]
                },
                "alternative_group": {
                  "type": "string",
                  "minLength": 1
                },
                "weight": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "rationale": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "path_type": {
                        "const": "alternative"
                      }
                    },
                    "required": [
                      "path_type"
                    ]
                  },
                  "then": {
                    "required": [
                      "alternative_group"
                    ]
                  }
                }
              ]
            }
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "genericity_traps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "why_insufficient",
          "related_relation_ids"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "why_insufficient": {
            "type": "string",
            "minLength": 1
          },
          "related_relation_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated_by",
        "reviewed_by",
        "review_notes"
      ],
      "properties": {
        "generated_by": {
          "type": "string",
          "minLength": 1
        },
        "reviewed_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "review_notes": {
          "type": "string"
        },
        "frozen_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "provenance": {
            "required": [
              "frozen_at"
            ],
            "properties": {
              "reviewed_by": {
                "minItems": 1
              }
            }
          }
        }
      }
    }
  ]
}
