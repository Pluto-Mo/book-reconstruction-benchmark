{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/judge-model-response.schema.json",
  "title": "Raw narrow relation Judge model response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "selected_candidate_ids",
    "decision",
    "support_found",
    "contradiction_found",
    "missing_facets",
    "reason",
    "confidence"
  ],
  "properties": {
    "selected_candidate_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "decision": {
      "type": "string",
      "enum": ["pass", "fail", "abstain"]
    },
    "support_found": {"type": "boolean"},
    "contradiction_found": {"type": "boolean"},
    "missing_facets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "direction",
          "mechanism",
          "condition",
          "boundary",
          "stance_owner",
          "epistemic_status",
          "argument_function",
          "case_identity"
        ]
      }
    },
    "reason": {"type": "string", "minLength": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"decision": {"const": "pass"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "selected_candidate_ids": {"minItems": 1},
          "support_found": {"const": true},
          "contradiction_found": {"const": false},
          "missing_facets": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "abstain"}},
        "required": ["decision"]
      },
      "then": {
        "properties": {
          "confidence": {"maximum": 0.5}
        }
      }
    }
  ]
}
