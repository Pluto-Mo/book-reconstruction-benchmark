{
  "schema_version": "2.0",
  "job": {
    "name": "breakthrough-advertising-pi-five-models-dev",
    "task_path": "tasks/breakthrough-advertising-dev",
    "n_attempts": 1,
    "n_concurrent_trials": 1
  },
  "pi": {
    "version": "0.84.1",
    "harbor_thinking": "xhigh",
    "thinking_policy": "highest_available",
    "models_path": "tasks/breakthrough-advertising-dev/environment/pi/models.json",
    "container_config_dir": "/opt/book-reconstruction/pi"
  },
  "hosted": {
    "credential_mode": "direct"
  },
  "setup_allowed_hosts": [
    "raw.githubusercontent.com",
    "github.com",
    "codeload.github.com",
    "objects.githubusercontent.com",
    "nodejs.org",
    "registry.npmjs.org",
    "deb.debian.org",
    "security.debian.org"
  ],
  "agents": [
    {
      "label": "GPT-5.6 sol",
      "provider": "openai-benchmark",
      "model": "gpt-5.6-sol",
      "secret_name": "OPENAI_BENCHMARK_API_KEY"
    },
    {
      "label": "Opus 5",
      "provider": "openai-benchmark",
      "model": "claude-opus-5",
      "secret_name": "OPENAI_BENCHMARK_API_KEY"
    },
    {
      "label": "Qwen 3.8 Max",
      "provider": "qwen-benchmark",
      "model": "qwen3.8-max",
      "secret_name": "QWEN_BENCHMARK_API_KEY"
    },
    {
      "label": "K3",
      "provider": "kimi-benchmark",
      "model": "kimi-k3",
      "secret_name": "KIMI_BENCHMARK_API_KEY"
    },
    {
      "label": "DS V4 Pro",
      "provider": "deepseek",
      "model": "deepseek-v4-pro",
      "secret_name": "DEEPSEEK_API_KEY"
    }
  ],
  "judge": {
    "label": "Qwen 3.8 Max",
    "provider": "qwen-benchmark",
    "model": "qwen3.8-max",
    "secret_name": "QWEN_BENCHMARK_API_KEY",
    "litellm_model": "openai/qwen3.8-max",
    "enable_thinking": true
  }
}
